# Public URL of the MailFlow backend. Root-relative values are also accepted.
# Infisical injects this at process start; the app does not load .env files.
VITE_API_BASE_URL=http://localhost:8080

# Optional public Grafana Faro browser telemetry configuration. Faro remains disabled
# unless all four values are present and valid.
VITE_FARO_COLLECTOR_URL=https://faro-collector-prod-sa-east-1.grafana.net/collect/7be70031d547757075957e088fc423e1
VITE_FARO_APP_NAME=mailflow-web
VITE_FARO_APP_ENVIRONMENT=development
VITE_FARO_APP_VERSION=0.1.0

# CI-only source map upload variables. Keep these out of VITE_* and browser bundles.
# FARO_SOURCEMAP_ENDPOINT=
# FARO_SOURCEMAP_APP_ID=
# FARO_SOURCEMAP_STACK_ID=
# FARO_SOURCEMAP_API_KEY=
# FARO_BUNDLE_ID=
