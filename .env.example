# Required public origin of the MailFlow backend (no path).
# Infisical injects this at process start; the app does not load .env files.
VITE_API_BASE_URL=http://localhost:8080

# Workspace hosting: every workspace lives on {slug}.VITE_WORKSPACE_BASE_HOST and keeps its own
# host-only session; any other host served by this Worker redirects to VITE_SITE_URL.
# Base host: production mailflow-ai.online, staging staging.mailflow-ai.online,
# development dev.mailflow-ai.online. Local dev uses localhost automatically.
# workspace.test is ONLY the isolated local browser-test zone, not a deployment value.
# VITE_WORKSPACE_BASE_HOST=dev.mailflow-ai.online
# Landing origin: https://mailflow-ai.online, https://site-staging.mailflow-ai.online,
# https://site-dev.mailflow-ai.online (local http://localhost:4321).
# VITE_SITE_URL=https://site-dev.mailflow-ai.online
# Requires the base host, the landing origin and an HTTPS API (loopback HTTP Core locally).
VITE_WORKSPACE_SWITCHING_ENABLED=false

# Optional public Grafana Faro browser telemetry configuration. Faro remains disabled
# unless all four values are present and valid.
VITE_FARO_COLLECTOR_URL=https://faro.example.test/collect
VITE_FARO_APP_NAME=mailflow-web
VITE_FARO_APP_ENVIRONMENT=development
VITE_FARO_APP_VERSION=0.1.0
