# Required public origin of the MailFlow backend (no path).
# Infisical injects this at process start; the app does not load .env files.
VITE_API_BASE_URL=http://localhost:8080

# Optional exact environment hostname (no scheme, port or wildcard).
# Leave unset until the coordinated workspace rollout is approved.
# workspace.test is ONLY the isolated local browser-test zone, not a deployment value.
# VITE_WORKSPACE_BASE_HOST=workspace.test
# Remote rollout: requires an isolated Web base host and HTTPS API.
# Example base host: app.staging.example.com (replace with the approved hostname).
VITE_WORKSPACE_SWITCHING_ENABLED=false
# Local browser tests only; mutually exclusive with the remote flag.
# Never enable this flag for published environments.
VITE_WORKSPACE_LOCAL_SWITCHING_ENABLED=false
# Both modes enable selection and generic-entry preference resolution.

# Optional public Grafana Faro browser telemetry configuration. Faro remains disabled
# unless all four values are present and valid.
VITE_FARO_COLLECTOR_URL=https://faro.example.test/collect
VITE_FARO_APP_NAME=mailflow-web
VITE_FARO_APP_ENVIRONMENT=development
VITE_FARO_APP_VERSION=0.1.0
